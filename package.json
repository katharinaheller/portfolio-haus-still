    "postbuild": "node scripts/postbuild.mjs",
    "build:production": "node scripts/production.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --allowJs --checkJs --noEmit --target ES2022 --module NodeNext --skipLibCheck public/site.js",
