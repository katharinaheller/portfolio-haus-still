  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.1",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.66.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.0",
    "@playwright/test": "^1.62.1"
  }
